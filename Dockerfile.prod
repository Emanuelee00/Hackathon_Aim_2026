# Production image: React build served by FastAPI, no hot reload, no AI.
FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Hides the chatbots (see ChatBubble.jsx).
ENV VITE_AI=off
RUN npm run build

FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    MARTHE_AI=0
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-dev --no-install-project
COPY . .
COPY --from=frontend /frontend/dist frontend/dist
RUN useradd --system marthe && chown -R marthe /app
USER marthe
EXPOSE 8000
# --proxy-headers: behind Caddy the app sees https, so cookies are Secure.
CMD ["/opt/venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--workers", "2"]
