# Copy to deploy/.env on the server and fill in (see README.md).
POSTGRES_PASSWORD=

# Hosts served over HTTPS: each one needs a DNS record pointing to the VM.
# Step 1, chezmarthe.site only. Step 2 (chezmarthe.org) is in README.md.
SITE_HOSTS=chezmarthe.site, www.chezmarthe.site, equipe.chezmarthe.site, residents.chezmarthe.site, benevoles.chezmarthe.site, partenaires.chezmarthe.site, bilan.chezmarthe.site

# Empty: no redirect. Step 2: CANONICAL_DOMAIN=chezmarthe.org, OLD_DOMAINS=chezmarthe.site
CANONICAL_DOMAIN=
OLD_DOMAINS=

# E-mails: the funding reminders (11 months after a funding is obtained) and the confirmations sent to people who fill in a form
# (activity or space request, contact page) and give their e-mail address. CONTACT_EMAIL is the address written in those e-mails.
CONTACT_EMAIL=contact@chezmarthe.org
# Set ONE of the two mail services; without it nothing is sent. MAIL_FROM must belong to a domain the service accepts.
REMINDER_TO=contact@chezmarthe.org
MAIL_FROM=Chez Marthe <contact@chezmarthe.org>
# Resend (https://resend.com, free up to about 3,000 emails a month):
RESEND_API_KEY=
# ...or any SMTP server:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
