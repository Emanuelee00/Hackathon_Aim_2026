# Copy to deploy/.env on the server and fill in (see README.md).
POSTGRES_PASSWORD=

# Hosts served over HTTPS: each one needs a DNS record pointing to the VM.
# Step 1, chezmarthe.site only. Step 2 (chezmarthe.org) is in README.md.
SITE_HOSTS=chezmarthe.site, www.chezmarthe.site, equipe.chezmarthe.site, residents.chezmarthe.site, benevoles.chezmarthe.site, partenaires.chezmarthe.site, bilan.chezmarthe.site

# Empty: no redirect. Step 2: CANONICAL_DOMAIN=chezmarthe.org, OLD_DOMAINS=chezmarthe.site
CANONICAL_DOMAIN=
OLD_DOMAINS=
